# Copy this file to .env and set the password for your local PostgreSQL.
# Existing database volumes require their current password.
POSTGRES_PASSWORD=

# Base64-encoded DER, without PEM headers, quotes, or line breaks.
# Private key: PKCS#8. Public key: X.509. Use a matching RSA pair (2048+ bits).
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=
